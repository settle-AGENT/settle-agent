{
	admin off
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle /health/backend {
		rewrite * /health
		reverse_proxy backend:{$BACKEND_CONTAINER_PORT}
	}

	handle /health/ai {
		rewrite * /health
		reverse_proxy ai:{$AI_CONTAINER_PORT}
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy backend:{$BACKEND_CONTAINER_PORT}
	}

	handle {
		reverse_proxy frontend:{$FRONTEND_CONTAINER_PORT}
	}
}
