{
	admin off
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# 첫 요청까지 평문으로 나가지 않게 한다. Caddy 가 80 → 443 리다이렉트를
		# 하지만 그 리다이렉트 자체가 평문이고, 신분증을 올리는 서비스다.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	handle /health/backend {
		rewrite * /health
		reverse_proxy backend:{$BACKEND_CONTAINER_PORT}
	}

	handle /health/ai {
		rewrite * /health
		reverse_proxy ai:{$AI_CONTAINER_PORT}
	}

	@api path /api /api/*
	handle @api {
		reverse_proxy backend:{$BACKEND_CONTAINER_PORT}
	}

	@swagger path /swagger-ui.html /swagger-ui/* /v3/api-docs /v3/api-docs/*
	handle @swagger {
		reverse_proxy backend:{$BACKEND_CONTAINER_PORT}
	}

	handle {
		reverse_proxy frontend:{$FRONTEND_CONTAINER_PORT}
	}
}
