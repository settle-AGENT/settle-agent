# ─────────────────────────────────────────────────────────────
# 참고용 템플릿. 실제 파일은 deploy/make-env.sh 가 만든다.
# 세 파일에 DB 비밀번호가 흩어지므로 손으로 쓰면 반드시 어긋난다.
# ─────────────────────────────────────────────────────────────

# ===== .env  (compose 치환용. 비밀 아님) =====
PUBLIC_DOMAIN=kaffy.kro.kr
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
FRONTEND_CONTAINER_PORT=3000
BACKEND_CONTAINER_PORT=8080
AI_CONTAINER_PORT=8000
POSTGRES_USER=settle
POSTGRES_DB=settle
POSTGRES_PASSWORD=<생성>
# 첫 기동은 update, 스키마 확인 후 validate 로 바꾸고 backend 재생성
JPA_DDL_AUTO=update

# ===== .env.secrets  (backend / format: raw → 따옴표 금지) =====
DB_URL=jdbc:postgresql://db:5432/settle
DB_USERNAME=settle
DB_PASSWORD=<위 POSTGRES_PASSWORD 와 동일해야 함>
JWT_SECRET=<32바이트 이상>
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=<버킷명>
AI_CONNECT_TIMEOUT_SECONDS=5
AI_READ_TIMEOUT_SECONDS=120

# ===== runtime.env  (ai / format: raw → 따옴표 금지) =====
DATABASE_URL=postgresql://settle:<위와 동일>@db:5432/settle
ANTHROPIC_API_KEY=<키>
# 리포 기본값. 현행 세대로 올리려면 claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-4-5
CLOVA_INVOKE_URL=<URL>
CLOVA_SECRET_KEY=<키>
RESEARCH_ENABLED=1
